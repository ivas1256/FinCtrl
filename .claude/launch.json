{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "FinCtrl/FinCtrl.Website/FinCtrl.Website.csproj", "--urls", "http://localhost:5000"],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "FinCtrl.Frontend/FinCtrl.Frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "ai-assistant",
      "runtimeExecutable": "FinCtrl.AiAssistant/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "FinCtrl.AiAssistant", "--port", "8000"],
      "port": 8000
    }
  ]
}
